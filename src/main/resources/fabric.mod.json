{
  "schemaVersion": 1,
  "id": "bbs_spatial_gui",
  "version": "${version}",
  "name": "BBS Spatial GUI",
  "description": "Spatial GUI integration for BBS-FS.",
  "authors": [
    "McAxolotl"
  ],
  "contributors": [
    "quaIett"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "bbs-client-addon": [
      "mcaxolotl.bbsspatialgui.BBSSpatialGui"
    ],
    "spatial_gui_extras:world_view": [
      "mcaxolotl.bbsspatialgui.compat.WorldViewFilter"
    ],
    "spatial_gui_extras:cursor_shape": [
      "mcaxolotl.bbsspatialgui.compat.CursorShape"
    ]
  },
  "mixins": [
    "bbs_spatial_gui.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "=1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "bbs": "=2.7-1.20.1",
    "spatial_gui": ">=1.11.1-hotfix <1.12"
  },
  "icon": "assets/bbs_spatial_gui/icon.png"
}
